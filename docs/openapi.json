{
  "openapi": "3.0.3",
  "info": {"title": "Kalz OmniSuite API", "version": "0.1.0"},
  "paths": {
    "/health": {"get": {"responses": {"200": {"description": "Service health"}}}},
    "/api/v1/profile": {"get": {"responses": {"200": {"description": "Distro and desktop profile"}}}},
    "/api/v1/plan": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlanRequest"}}}}, "responses": {"200": {"description": "Dry-run plan"}, "400": {"description": "Invalid input"}}}}
  },
  "components": {"schemas": {"PlanRequest": {"type": "object", "required": ["packages"], "properties": {"packages": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}$"}}}}}}
}
